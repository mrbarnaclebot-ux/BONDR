# --- Shared (web and worker) ---
# Postgres URL, direct (non-pooled) endpoint: migrate.ts holds a session advisory lock. Locally the Neon dev branch.
DATABASE_URL=
# Solana network the app runs against: devnet | mainnet. The worker also needs ALLOW_MAINNET=1 and
# TREASURY_PUBKEY for mainnet.
SOLANA_NET=
# The owner's wallet address (a public key, not a secret), the only wallet allowed into /admin. Set the same
# value on web and worker. Unset or invalid keeps admin closed on both.
ADMIN_WALLET=
# Public origin of the site (staging sets its public URL, production https://trybondr.fun). Web: absolute share
# card URLs, and the admin sign-in message names it. Worker: every admin money intent names it, so set the same
# value on both; unset on the worker refuses admin simulate and execute with 403.
SITE_URL=http://127.0.0.1:3000

# --- Worker only ---
# Helius API key (https://dashboard.helius.dev). Used for devnet and mainnet RPC.
helius_api_key=
# Master seed for derived keys, inline (32 bytes, base64). Prefer MASTER_SEED_FILE locally.
MASTER_SEED=
# Path to a file holding the master seed, outside the repo.
MASTER_SEED_FILE=
# Vanity lane: local | staging. Part of every mint key id, so the two pools never share a mint.
VANITY_LANE=
# Background grinder threads (default 1). 0 disables background grinding; the Mac pre-fill is the main path.
VANITY_THREADS=
# BONDR mint address: the quote token every launch pairs against.
BONDR_QUOTE_MINT=
# Shared secret the web sends to the worker; must match the web's WORKER_TOKEN.
WORKER_TOKEN=
# Priority fee for launch transactions, in micro-lamports per compute unit.
PRIORITY_FEE_MICROLAMPORTS=
# Worker only. 1 allows SOLANA_NET=mainnet; anything else refuses to boot on mainnet (D-01).
ALLOW_MAINNET=
# Worker only. Public key of an owner-held wallet not derived from MASTER_SEED: the mainnet treasury and the
# EVACUATE destination. Required on mainnet, unused on devnet (OWNER GATE G-2).
TREASURY_PUBKEY=
# Sentry DSN of the bondr-worker project.
SENTRY_DSN=
# Fee engine: off (default) | dry (build and simulate, write nothing) | on. Keep off locally except for the e2e.
FEE_ENGINE=off
# Fee window length in ms (default 86400000, at least 60000).
FEE_WINDOW_MS=
# UTC hour (0-23) of the daily fee batch (default 4).
FEE_BATCH_HOUR_UTC=
# Read-only Sentry token (event:read) for the admin health issue count. Unset shows "Sentry not configured".
SENTRY_READ_TOKEN=
# EVACUATE mode: simulate (default, never sends) | on. Staging stays simulate.
ADMIN_EVACUATE=

# --- Web only ---
# Base URL of the worker HTTP API.
WORKER_URL=
# Same value as the worker's WORKER_TOKEN (listed under worker above).
# WORKER_TOKEN=
# Pinata JWT for the v3 upload API.
pinata_jwt=
# Dedicated Pinata gateway host (name.mypinata.cloud); falls back to ipfs.io when unset.
PINATA_GATEWAY=
# Sentry DSN of the bondr-web project (public by design, sent to browsers).
NEXT_PUBLIC_SENTRY_DSN=
# HMAC key for the consent nonce and the wallet session cookie, 32+ random characters, one per environment
# (openssl rand -base64 48). Changing it signs every wallet out, which is harmless: they sign consent again.
SESSION_SECRET=
# 1 turns on GET /api/sentry-test (one test error from web and from the worker); unset everywhere else.
SENTRY_TEST_ROUTE=

# --- Owner tooling (never on a deployed service) ---
# Sentry auth token (project:write, project:read, org:read) used once to create the projects.
sentry_auth_token=
# Staging web (Railway): https://web-staging-72bad.up.railway.app
# Direct URL of the Neon main branch (staging), for manual checks only.
DATABASE_URL_STAGING=

# --- Legacy (unused: the v3 upload API needs only pinata_jwt) ---
# pinata_api_key=
# pinata_secret_api_key=

# --- Phase 1 spike ---
# Network for pnpm spike: devnet | fork | all (default all).
# SPIKE_NET=all
# Where master seeds live, outside the repo (default ~/.bondr-spike).
# SPIKE_KEYS_DIR=
# Run one stage only, by stage name.
# SPIKE_ONLY=
# 1 re-runs devnet stages that already passed.
# SPIKE_FRESH=
# Local fork RPC (default http://127.0.0.1:18899).
# SPIKE_FORK_URL=
