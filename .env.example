# --- Shared (web and worker) ---
# Postgres URL, direct (non-pooled) endpoint: migrate.ts holds a session advisory lock. Locally the Neon dev branch.
DATABASE_URL=
# Solana network the app runs against: devnet | mainnet.
SOLANA_NET=

# --- Worker only ---
# Helius API key (https://dashboard.helius.dev). Used for devnet and mainnet RPC.
helius_api_key=
# Master seed for derived keys, inline (hex). Prefer MASTER_SEED_FILE locally.
MASTER_SEED=
# Path to a file holding the master seed, outside the repo.
MASTER_SEED_FILE=
# Vanity grinder lane id, so parallel grinders never share an index range.
VANITY_LANE=
# BONDR mint address: the quote token every launch pairs against.
BONDR_QUOTE_MINT=
# Shared secret the web sends to the worker; must match the web's WORKER_TOKEN.
WORKER_TOKEN=
# Priority fee for launch transactions, in micro-lamports per compute unit.
PRIORITY_FEE_MICROLAMPORTS=
# 1 allows mainnet sends; anything else refuses them.
ALLOW_MAINNET=
# Sentry DSN of the bondr-worker project.
SENTRY_DSN=

# --- Web only ---
# Base URL of the worker HTTP API.
WORKER_URL=
# Same value as the worker's WORKER_TOKEN (listed under worker above).
# WORKER_TOKEN=
# Pinata JWT for the v3 upload API.
pinata_jwt=
# Dedicated Pinata gateway host (name.mypinata.cloud); falls back to ipfs.io when unset.
PINATA_GATEWAY=
# Sentry DSN of the bondr-web project (public by design, sent to browsers).
NEXT_PUBLIC_SENTRY_DSN=

# --- Owner tooling (never on a deployed service) ---
# Sentry auth token (project:write, project:read, org:read) used once to create the projects.
sentry_auth_token=
# Direct URL of the Neon main branch (staging), for manual checks only.
DATABASE_URL_STAGING=

# --- Legacy (unused: the v3 upload API needs only pinata_jwt) ---
# pinata_api_key=
# pinata_secret_api_key=

# --- Phase 1 spike ---
# Network for pnpm spike: devnet | fork | all (default all).
# SPIKE_NET=all
# Where master seeds live, outside the repo (default ~/.bondr-spike).
# SPIKE_KEYS_DIR=
# Run one stage only, by stage name.
# SPIKE_ONLY=
# 1 re-runs devnet stages that already passed.
# SPIKE_FRESH=
# Local fork RPC (default http://127.0.0.1:18899).
# SPIKE_FORK_URL=
